# SOCKS5 Proxy Configuration
# All env vars override config.json values.

# ─── Proxy ─────────────────────────────────────────────────────────────────
PROXY_PORT=1080
ADMIN_PORT=8080
METRICS_PORT=9090

# ─── SOCKS5 authentication ─────────────────────────────────────────────────
# CHANGE BOTH before exposing this to anything but localhost.
AUTH_ENABLED=true
PROXY_USER=changeme
PROXY_PASS=changeme
MAX_CONNECTIONS=1000

# ─── Admin dashboard & metrics auth ────────────────────────────────────────
ADMIN_USER=admin
ADMIN_PASS=changeme
ADMIN_AUTH_ENABLED=true

# ─── Session timeouts (seconds) ────────────────────────────────────────────
# read/write cover the handshake and protocol replies.
# idle is the deadline on an ESTABLISHED proxy session: set it above the
# interval at which your clients send keepalives or idle sessions get dropped.
READ_TIMEOUT_SECONDS=30
WRITE_TIMEOUT_SECONDS=30
IDLE_TIMEOUT_SECONDS=300

# ─── UDP ───────────────────────────────────────────────────────────────────
# SOCKS5 UDP ASSOCIATE. This is what Telegram, QUIC and DNS-over-UDP need.
# Set false to allow TCP connections only.
UDP_ENABLED=true

# ─── Telegram (MTProto) ─────────────────────────────────────────────────────
# Telegram's own protocol, served on its own port because it is not SOCKS5.
# Needs a port of its own: 443 is normally taken by REALITY.
# Add secrets in the dashboard; it generates the first one on first start.
MTPROTO_ENABLED=false
MTPROTO_BIND=0.0.0.0:8443
# Only needed if Telegram's own addresses are unreachable from this host:
# MTPROTO_DCS=2=10.0.0.1:443,4=10.0.0.2:443
# Secret kind for newly generated secrets: dd (obfuscated2) or ee (fake TLS).
# Fake TLS makes the port look like a website to a prober.
MTPROTO_SECRET_KIND=dd
# The domain the fake TLS reply is built around when a client does not name one.
# MTPROTO_FAKE_HOST=www.cloudflare.com

# ─── Security ──────────────────────────────────────────────────────────────
SECURITY_HEADERS_ENABLED=true

# ─── Rate limiting (admin endpoints) ───────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_RPS=30

# ─── Single-port mode ──────────────────────────────────────────────────────
# When set, SOCKS5, TLS, the HTTP proxy, the dashboards and the tunnel ALL share
# this one port. Auto-detected from PORT, which Render/Koyeb/Heroku inject.
# Northflank does not inject PORT, so set SINGLE_PORT explicitly there.
#
#   SINGLE_PORT=8080
#
# Leave both unset on a VPS to keep the three traditional ports.

# ─── WebSocket tunnel ──────────────────────────────────────────────────────
# For platforms whose edge terminates TLS and forwards HTTP only, so raw SOCKS5
# never reaches the app. TUNNEL_ENABLED is refused at startup without a token,
# so a fork cannot accidentally become an open proxy.
TUNNEL_ENABLED=false
TUNNEL_TOKEN=
TUNNEL_PATH=/api/v1/tunnel
# Message padding in bytes; 0 or 1 disables. 256 is a sensible default.
TUNNEL_PADDING=256
TUNNEL_RATE_LIMIT_RPS=5

# ─── TLS ───────────────────────────────────────────────────────────────────
# Both empty generates a self-signed cert in memory at startup, served at
# /tls-cert. Behind a PaaS edge the client never sees this cert.
# TLS_CERT_FILE=/path/fullchain.pem
# TLS_KEY_FILE=/path/privkey.pem
TLS_CERT_FILE=
TLS_KEY_FILE=

# ─── REALITY (Xray) ────────────────────────────────────────────────────────
# A front door that is indistinguishable from a real website: an unauthenticated
# prober gets the camouflage site's certificate, and authenticated clients look
# like its visitors. Needs a VPS with a DEDICATED IP, raw TCP to 443, and a
# DNS-only record (grey cloud) -- behind a CDN the edge terminates TLS first and
# a REALITY client can never reach you. Use the WebSocket tunnel on CDN-fronted
# PaaS instead; the two are mutually exclusive.
#
# Sessions are forwarded to this proxy's SOCKS5 port, so users, tiers, rate
# limits and metrics all keep applying. Requires the xray binary: the Docker
# image ships it, otherwise install xray or point XRAY_BIN at it.
REALITY_ENABLED=false
REALITY_BIND=0.0.0.0:443
# The site whose certificate is presented to a prober. Must speak TLS 1.3 with
# X25519, must be reachable from the server, and must resolve to a real CDN.
# Change it: a target that is obviously an outlier can get your IP blocked.
# Xray also warns against apple/icloud targets for the same reason.
REALITY_DEST=www.lovelive-anime.jp:443
# SNI values to impersonate. Empty means "the host part of REALITY_DEST".
# REALITY_SERVER_NAMES=www.lovelive-anime.jp
# Generated once and reused from the database when left empty. Set it explicitly
# to keep the same key across a database reset, or to pin a known pair:
#   xray x25519
# REALITY_PRIVATE_KEY=
# 8 bytes of hex, up to 16 characters. Rotating this locks out every client.
# REALITY_SHORT_IDS=
# VLESS UUIDs, one per client device. Generated when empty:
#   xray uuid
# REALITY_CLIENT_IDS=
# Written into the client config at startup. Set it to this host's IP or domain
# so the generated file is usable as-is instead of carrying SERVER_IP.
REALITY_PUBLIC_HOST=
XRAY_BIN=xray
REALITY_CLIENT_FILE=reality-client.json

# ─── Backup ─────────────────────────────────────────────────────────────────
# `socks5-proxy backup -out FILE [-passphrase P]` snapshots the database with
# VACUUM INTO, which is safe while the server is running. The archive holds every
# user password and the REALITY private key, so encrypt anything that leaves the
# machine. Restore with `socks5-proxy restore -in FILE`, server stopped.
