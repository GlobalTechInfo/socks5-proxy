# SOCKS5 Proxy Configuration
# All env vars override config.json values

# Proxy
PROXY_PORT=1080
ADMIN_PORT=8080
METRICS_PORT=9090

# SOCKS5 Authentication
PROXY_USER=changeme
PROXY_PASS=changeme
MAX_CONNECTIONS=1000

# Admin Dashboard & Metrics Auth
ADMIN_USER=admin
ADMIN_PASS=changeme
ADMIN_AUTH_ENABLED=true

# Security
SECURITY_HEADERS_ENABLED=true

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_RPS=30
